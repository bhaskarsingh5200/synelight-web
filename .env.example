# ============================================================
# SYNELIGHT — environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to Git.
# ============================================================

# ---- Server ----
PORT=3000
# Public site URL (no trailing slash)
# Staging:  https://your-app.onrender.com
# Production: https://synelight.com
SITE_URL=
# Redirect http->https behind proxies/load balancers that set x-forwarded-proto
FORCE_HTTPS=false

# ---- Supabase (primary lead database) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# service_role key — SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Leave both empty to run without Supabase: leads are stored locally
# in data/leads.json instead.

# ---- Email (order of preference) ----
# 1) Resend — https://resend.com (add & verify the sender domain there)
RESEND_API_KEY=
MAIL_FROM=SYNELIGHT <synelight@gmail.com>
# 2) Generic webhook (Make / Zapier / n8n) receives {type,to,subject,text}
MAIL_WEBHOOK_URL=
# 3) Raw SMTP fallback (implicit TLS, port 465).
#    Easiest for synelight@gmail.com: enable 2-Step Verification on the
#    Google account, create an "App Password" at myaccount.google.com →
#    Security → App passwords, then:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=465
#      SMTP_USER=synelight@gmail.com
#      SMTP_PASS=<16-char app password>
#      SMTP_FROM=synelight@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Internal notification recipient — where NEW ENQUIRY alerts land.
# Defaults to the address inside MAIL_FROM if left empty.
LEAD_NOTIFICATION_EMAIL=synelight@gmail.com

# ---- WhatsApp ----
# Digits only with country code, e.g. 919876543210
# Empty = falls back to the built-in default 8409405200
WHATSAPP_NUMBER=8409405200
# WhatsApp Cloud API (graph.facebook.com) — sends a NEW ENQUIRY alert to
# WHATSAPP_TO on every lead. Leave empty to skip. Setup: developers.facebook.com →
# WhatsApp → create app → add WhatsApp product → link the business number
# 8409405200 → create a permanent "system user" token → copy the phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=918409405200

# ---- Booking / scheduling (Calendly, Cal.com...) ----
# Full URL. Empty = BOOK A CALL buttons route to /contact instead.
BOOKING_URL=

# ---- Google Analytics 4 ----
GA4_ID=
# A consent banner gates GA4 automatically when this is set.

# ---- Cloudflare Turnstile (optional spam protection) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Admin panel (/admin) ----
# Strong password required before any admin access is possible.
ADMIN_PASSWORD=
