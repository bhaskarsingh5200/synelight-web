# ============================================================
# SYNELIGHT — environment configuration
# Copy this file to ".env" and fill in your real values,
# THEN set those values as Vercel Environment Variables (Settings > Environment
# Variables in the synelight-web project).
# .env itself is git-ignored — never commit it.
# ============================================================

# ---- Server ----
PORT=3000
# Signs the admin session cookie. Use a long random string (e.g. from
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# If unset it falls back to ADMIN_PASSWORD.
SESSION_SECRET=
# Production URL, no trailing slash. Set this to stop the staging noindex
# robots.txt and to give blog posts their real canonical URLs.
SITE_URL=https://synelight-web.vercel.app
# Redirect http->https behind proxies that set x-forwarded-proto
FORCE_HTTPS=true

# ---- Supabase (leads + blog database) ----
# Dashboard > Project Settings > API
# Copy these three: Project URL, anon key (ignore), service_role key.
SUPABASE_URL=https://YOURPROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# ---- Email — pick ONE transport ----
# Option A) Resend (recommended, easiest):
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM must be on a verified domain in Resend. Example:
#   MAIL_FROM=SYNELIGHT <no-reply@synelight.com>
# If unset it defaults to SYNELIGHT <synelight@gmail.com>.
MAIL_FROM=SYNELIGHT <no-reply@synelight.com>

# Option B) Gmail SMTP (skip Resend, ignore Option A):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=synelight@gmail.com
#   SMTP_PASS=<16-character Gmail App Password>
#   SMTP_FROM=synelight@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Internal notification recipient — where NEW ENQUIRY alerts land.
# Defaults to the address inside MAIL_FROM if left empty.
LEAD_NOTIFICATION_EMAIL=synelight@gmail.com

# ---- WhatsApp (optional lead alert) ----
WHATSAPP_NUMBER=8409405200
# Meta WhatsApp Cloud API credentials. Leave blank to skip.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Recipient in E.164 digits (country code + number, no + sign):
WHATSAPP_TO=918409405200

# ---- Booking / scheduling (optional) ----
BOOKING_URL=

# ---- Google Analytics 4 ----
GA4_ID=G-EBCLNLPWED

# ---- Cloudflare Turnstile (optional spam protection) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Admin panel ----
ADMIN_PASSWORD=