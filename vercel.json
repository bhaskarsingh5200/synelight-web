{
  "version": 2,
  "buildCommand": "node scripts/build-sitemap.js",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "**/*.html",
          "**/*.css",
          "**/*.js",
          "**/*.svg",
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.webp",
          "**/*.avif",
          "**/*.ico",
          "**/*.xml",
          "**/*.txt",
          "**/*.woff2"
        ],
        "excludeFiles": [
          "data/**",
          ".vercel/**",
          ".git/**",
          "scripts/**",
          "supabase/**",
          "*.md",
          ".env*"
        ]
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}